<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only, system certificate authorities only. Debug builds override this file
     (src/debug/res/xml) to allow cleartext to a local test server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
